# Copy to .env (git-ignored) and fill in. Spring Boot reads .env from the project root,
# so the app works from STS, the terminal and Maven without setting OS variables.
# On servers do NOT use this file: set these as real environment variables / secrets.

# dev = local machine (SQL logging, Swagger UI). Servers use prod.
SPRING_PROFILES_ACTIVE=dev

# Generate with: openssl rand -base64 32   (each environment gets its own value)
JWT_SECRET=

# Password of your local PostgreSQL user (required, there is no default)
DB_PASSWORD=

# Optional in dev: defaults point to the local PostgreSQL on port 5432
# DB_URL=jdbc:postgresql://localhost:5432/satmis
# DB_USERNAME=postgres

# To use the docker-compose database instead:
# DB_URL=jdbc:postgresql://localhost:5433/satmis
# DB_USERNAME=satmis
# DB_PASSWORD=satmis

# Mail in dev goes to Mailpit: run `docker compose up -d mailpit`, read mails at http://localhost:8025

# prod only (all required): DB_URL, DB_USERNAME, DB_PASSWORD, JWT_SECRET,
# CORS_ALLOWED_ORIGINS (comma-separated, e.g. https://satmis.com),
# MAIL_HOST, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM, FRONTEND_BASE_URL (optional MAIL_PORT, default 587).
# Optional: SWAGGER_ENABLED=true exposes the API docs publicly, e.g. for a demo.
